{
  "installCommand": "pnpm install",
  "buildCommand": "CI='' pnpm run build:server",
  "outputDirectory": "packages/webapp/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "packages/server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon.ico|manifest.json|preload-theme.js).*)",
      "destination": "/index.html"
    }
  ]
}
